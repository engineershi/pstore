      "id": "00000000-0000-4000-8000-000000000013",
      "name": "Fetch pin health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Turn the /api/pin-health payload into one alert (or an all-clear).\nconst d = $json.json ?? {};\nconst counts = d.counts ?? {};\nconst noPin = (d.traffic_no_pin ?? []).slice(0, 15);\nconst silent = (d.published_silent ?? []).slice(0, 15);\n\nif (!(d.published_silent ?? []).length && !(d.traffic_no_pin ?? []).length) {\n  return [{ json: { alert: '', needsAttention: false } }];\n}\n\nconst lines = ['pstore pin health (' + (d.days ?? '-') + 'd)'];\nlines.push(\n  'pin clicks: ' + (counts.pin_clicks ?? 0),\n  'pinned & clicked: ' + (counts.pinned_with_clicks ?? 0),\n  'traffic, never from a pin: ' + (counts.traffic_without_pins ?? 0),\n  'feed niches silent: ' + (counts.silent ?? 0),\n);\nif (noPin.length) {\n  lines.push('— got clicks but no pin source:');\n  for (const r of noPin) lines.push('• ' + r.slug + ' (clicks ' + r.total_clicks + ')');\n}\nif (silent.length) {\n  lines.push('— in the feed, zero clicks (not pinned yet?):');\n  for (const r of silent) lines.push('• ' + r.slug);\n}\nif ((d.counts ? {}.toString.call(d.counts) : true)) {\n  const listed = noPin.length + silent.length;\n  const total = (counts.traffic_without_pins ?? 0) + (counts.silent ?? 0);\n  if (listed < total) lines.push('… +' + (total - listed) + ' more: see /api/pin-health');\n}\nreturn [{ json: { alert: lines.join('\\n'), needsAttention: true } }];"
      },
