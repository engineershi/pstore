              "leftValue": "={{ $json.telegram }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        }
      },
      "id": "00000000-0000-4000-8000-000000000024",
      "name": "Telegram on?",
